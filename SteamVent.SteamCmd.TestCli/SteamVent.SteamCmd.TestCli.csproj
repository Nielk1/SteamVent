<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>SteanVent.SteamCmd.TestCli</RootNamespace>
    <AssemblyName>SteanVent.SteamCmd.TestCli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Legacy .NET Framework AssemblyInfo conflicts with the SDK-generated one -->
    <Compile Remove="Properties\AssemblyInfo.cs" />
    <None Remove="Properties\AssemblyInfo.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamVent.SteamCmd\SteamVent.SteamCmd.csproj" />
  </ItemGroup>

  <!--
    Native runtime dependencies of SteamVent.SteamCmd (steamcmdinj.dll, steamcmdprox.exe)
    are produced by the Visual Studio C++ projects and copied by SteamVent.SteamCmd's own PostBuild target.
    If they are present in SteamVent.SteamCmd's output, copy them here so this console tool can run.
  -->
  <Target Name="CopyNativeRuntimeDependencies" AfterTargets="PostBuildEvent">
    <Exec Command="copy /Y &quot;$(MSBuildThisFileDirectory)..\SteamVent.SteamCmd\bin\$(Configuration)\net10.0\steamcmdinj.dll&quot; &quot;$(TargetDir)steamcmdinj.dll&quot;" Condition="Exists('$(MSBuildThisFileDirectory)..\SteamVent.SteamCmd\bin\$(Configuration)\net10.0\steamcmdinj.dll')" />
    <Exec Command="copy /Y &quot;$(MSBuildThisFileDirectory)..\SteamVent.SteamCmd\bin\$(Configuration)\net10.0\steamcmdprox.exe&quot; &quot;$(TargetDir)steamcmdprox.exe&quot;" Condition="Exists('$(MSBuildThisFileDirectory)..\SteamVent.SteamCmd\bin\$(Configuration)\net10.0\steamcmdprox.exe')" />
    <Exec Command="copy /Y &quot;$(MSBuildThisFileDirectory)..\SteamVent.SteamCmd\bin\$(Configuration)\net10.0\steamcmdprox.pdb&quot; &quot;$(TargetDir)steamcmdprox.pdb&quot;" Condition="Exists('$(MSBuildThisFileDirectory)..\SteamVent.SteamCmd\bin\$(Configuration)\net10.0\steamcmdprox.pdb')" />
  </Target>

</Project>
