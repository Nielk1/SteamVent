<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- xunit.v3 builds a self-contained test host executable, so the project must be an Exe -->
    <OutputType>Exe</OutputType>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <PackageReference Include="NLog" Version="5.2.8" />
    <!-- xunit.v3 bundles both the test framework and the Microsoft Testing Platform (MTP) runner,
         so Microsoft.NET.Test.Sdk / xunit.runner.visualstudio / coverlet.collector are no longer needed -->
    <PackageReference Include="xunit.v3" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SteamVent.Common\SteamVent.Common.csproj" />
    <ProjectReference Include="..\SteamVent.Bridge\SteamVent.Bridge.csproj" />
    <ProjectReference Include="..\SteamVent\SteamVent.csproj" />
    <ProjectReference Include="..\SteamVent.SteamCmd\SteamVent.SteamCmd.csproj" />
    <!-- Referencing the bridge executable project pulls SteamVentContextBridge.exe (and its
         dependencies) into the test output, where BridgeContext expects to find it. -->
    <ProjectReference Include="..\SteamVentContextBridge\SteamVentContextBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!--
    Native runtime dependencies of SteamVent.SteamCmd (steamcmdinj.dll, steamcmdprox.exe)
    are produced by the Visual Studio C++ projects and copied by SteamVent.SteamCmd's own PostBuild target.
    If they are present in SteamVent.SteamCmd's output, copy them here so SteamCmd tests can run.
  -->
  <!--
    BridgeContext expects SteamVentContextBridge.exe next to the entry assembly (the test host).
    ProjectReference does not copy the referenced exe's apphost, so copy the bridge output here
    (mirrors the SteamCmd native dependency copy target above).
  -->
  <Target Name="CopyContextBridgeOutput" AfterTargets="Build">
    <Exec Command="xcopy /Y /I /Q &quot;$(MSBuildThisFileDirectory)..\SteamVentContextBridge\bin\$(Configuration)\net10.0\*&quot; &quot;$(TargetDir)&quot;" Condition="Exists('$(MSBuildThisFileDirectory)..\\SteamVentContextBridge\\bin\\$(Configuration)\\net10.0\\SteamVentContextBridge.exe')" />
  </Target>

  <Target Name="CopyNativeRuntimeDependencies" AfterTargets="Build">
    <Exec Command="copy /Y &quot;$(MSBuildThisFileDirectory)..\SteamVent.SteamCmd\bin\$(Configuration)\net10.0\steamcmdinj.dll&quot; &quot;$(TargetDir)steamcmdinj.dll&quot;" Condition="Exists('$(MSBuildThisFileDirectory)..\SteamVent.SteamCmd\bin\$(Configuration)\net10.0\steamcmdinj.dll')" />
    <Exec Command="copy /Y &quot;$(MSBuildThisFileDirectory)..\SteamVent.SteamCmd\bin\$(Configuration)\net10.0\steamcmdprox.exe&quot; &quot;$(TargetDir)steamcmdprox.exe&quot;" Condition="Exists('$(MSBuildThisFileDirectory)..\SteamVent.SteamCmd\bin\$(Configuration)\net10.0\steamcmdprox.exe')" />
    <Exec Command="copy /Y &quot;$(MSBuildThisFileDirectory)..\SteamVent.SteamCmd\bin\$(Configuration)\net10.0\steamcmdprox.pdb&quot; &quot;$(TargetDir)steamcmdprox.pdb&quot;" Condition="Exists('$(MSBuildThisFileDirectory)..\SteamVent.SteamCmd\bin\$(Configuration)\net10.0\steamcmdprox.pdb')" />
  </Target>

</Project>
